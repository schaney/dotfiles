#!/usr/bin/env bash
set -e
outdir="$HOME/screenshots"
#outdir="$HOME/soc/screenshots"
#img="$(uuidgen).png"
img="screenshot.png"
out="${outdir}/${img}"
sleep 2
if [[ $1 == "select" ]]; then
  notify-send -a scrot "select area"
  sleep 0.3;
  scrot -f -s $out -e 'xclip -selection c -t image/png < $f'
elif [[ $1 == "window" ]]; then
  scrot -bu $out -e 'xclip -selection c -t image/png < $f'
else
  sleep 0.3;
  scrot -f -s $out -e 'xclip -selection c -t image/png < $f'
fi

cp $outdir/$(ls $outdir -Art | tail -n 1) $outdir/latest.png
notify-send -a scrot "copied to clipboard"
